{
  "name": "feathers-stripe",
  "description": "A Feathers service for Stripe",
  "version": "4.0.0",
  "homepage": "https://github.com/feathersjs-ecosystem/feathers-stripe",
  "keywords": [
    "stripe",
    "feathers",
    "feathers-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/feathersjs-ecosystem/feathers-stripe.git"
  },
  "author": {
    "name": "Feathers contributors",
    "email": "hello@feathersjs.com",
    "url": "https://feathersjs.com"
  },
  "contributors": [],
  "bugs": {
    "url": "https://github.com/feathersjs-ecosystem/feathers-stripe/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsdown",
    "version": "pnpm run build",
    "changelog": "github_changelog_generator --no-issues -p feathers-stripe -u feathersjs-ecosystem && git add CHANGELOG.md && git commit -am \"Updating changelog\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "vitest": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "attw": "attw --pack . --profile esm-only"
  },
  "prettier": "@feathers-community/eslint-config/prettier",
  "dependencies": {
    "@feathersjs/commons": "^5.0.50",
    "@feathersjs/errors": "^5.0.50"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@feathers-community/eslint-config": "^0.3.0",
    "@feathersjs/express": "^5.0.50",
    "@feathersjs/feathers": "^5.0.50",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "stripe": "^23.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@feathersjs/feathers": "^5.0.50",
    "stripe": "^23.0.0"
  }
}
